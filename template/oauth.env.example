# Google OAuth 2.0 client credentials. Rendered to vault/oauth.env, which is
# gitignored and chmod 600.
#
# These values are NOT passed to the container as environment variables.
# scripts/vaultctl.sh render writes each one to vault/secrets/<name>, which
# Compose mounts at /run/secrets/<name>; JCasC reads them from there. That
# keeps them out of `docker inspect` and /proc/1/environ.
#
# Obtain both from Google Cloud Console -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
