# Break-glass local administrator password, used only in recovery mode
# (`make recovery-up`) when a broken OAuth configuration has locked everyone
# out. See casc-recovery/jenkins.yaml.
#
# Left empty here on purpose: `scripts/vaultctl.sh init` generates a random
# value so a weak or shared default can never reach a running controller.
# Rotate after every use with `make recovery-rotate`.
RECOVERY_ADMIN_PASSWORD=
