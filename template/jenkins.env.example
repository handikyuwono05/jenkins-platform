# Non-sensitive settings. Rendered to vault/jenkins.env by scripts/vaultctl.sh.
# Compose reads this file for ${...} interpolation (--env-file).

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Public root URL of this Jenkins, WITH trailing slash. The Google OAuth
# redirect URI is derived from it as <JENKINS_URL>securityRealm/finishLogin and
# must match the Authorised redirect URI registered in Google Cloud exactly.
# Google permits plain http only for http://localhost.
JENKINS_URL=http://localhost:8080/

# Google account (email) granted Overall/Administer. Its domain MUST appear in
# GOOGLE_ALLOWED_DOMAINS or nobody will hold admin after login.
JENKINS_ADMIN_EMAIL=you@yourdomain.co.id

# Comma-separated Google Workspace domain allowlist. NEVER leave this empty: an
# empty value lets any Google account on the internet authenticate. A public
# domain such as gmail.com is equivalent to no restriction.
GOOGLE_ALLOWED_DOMAINS=yourdomain.co.id

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Keep the published port on loopback; terminate TLS in a reverse proxy for
# anything beyond local use.
JENKINS_HTTP_BIND=127.0.0.1
JENKINS_HTTP_PORT=8080

# Build executors ON THE CONTROLLER. Use 0 in production and attach agents: a
# build here can read JENKINS_HOME, including the credential store.
JENKINS_CONTROLLER_EXECUTORS=1

TZ=Asia/Jakarta
IMAGE_NAME=jenkins-platform
IMAGE_TAG=local

# Base image, pinned by tag and digest. Must match the JENKINS_BASE default in
# the Dockerfile; `make validate` enforces that. Check with `make base-digest`.
JENKINS_BASE=jenkins/jenkins:2.568.3-lts-jdk21@sha256:c1e4c349365f6d16d88595b2c5f7e8ff39b8ae1d061f62420bac193b4b9616d0

JENKINS_MEM_LIMIT=2g
JENKINS_CPU_LIMIT=2
